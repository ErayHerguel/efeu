{
  "name": "efeu",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/excalidraw-assets.mjs && vite",
    "build": "node scripts/excalidraw-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "build:mac": "npm run tauri build -- --target aarch64-apple-darwin",
    "build:mac:universal": "npm run tauri build -- --target universal-apple-darwin",
    "install-mac": "bash scripts/install-mac.sh",
    "smoke": "bash scripts/smoke-test.sh",
    "cargo-check": "cd src-tauri && PATH=\"$HOME/.cargo/bin:$PATH\" cargo check",
    "cargo-test": "cd src-tauri && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test",
    "licenses": "node scripts/check-licenses.mjs",
    "icons": "node scripts/make-icon.mjs && tauri icon src-tauri/icons/source.png -o src-tauri/icons && rm -rf src-tauri/icons/android src-tauri/icons/ios src-tauri/icons/Square*.png src-tauri/icons/StoreLogo.png src-tauri/icons/64x64.png",
    "version:set": "node scripts/set-version.mjs",
    "build:win": "tauri build --bundles nsis",
    "build:server": "vite build -c vite.server.config.ts && node scripts/pack-web.mjs && node scripts/sign-server.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "2.4.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-sql": "2.5.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extension-collaboration-caret": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@tiptap/y-tiptap": "3.0.9",
    "emojibase-data": "^17.0.0",
    "lib0": "0.2.117",
    "lowlight": "3.3.0",
    "lucide-react": "1.52.0",
    "markdown-it": "15.0.2",
    "markdown-it-mark": "4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uqr": "0.1.3",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "ws": "8.21.3"
  },
  "allowScripts": {
    "fsevents": false
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "katex": "0.19.0",
    "nanoid": "3.3.20",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
