{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "flou",
  "version": "1.9.1",
  "identifier": "app.flou.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "flou",
        "backgroundThrottling": "disabled",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 21
        },
        "dragDropEnabled": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https://images.unsplash.com; worker-src 'self' blob:; font-src 'self' data:; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Lokale Notizen und Datenbanken",
    "copyright": "© 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 360
        },
        "appPosition": {
          "x": 140,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "flou"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5QUE3REExOEIzMTRCRUIKUldUclN6R0xvWDJxeWRGSWdIdzZQMWY0TUlEeE9lZ0pIbHIxQWUvNnlHamZ5bVVTcDVrK1BmVy8K",
      "endpoints": [
        "https://github.com/ErayHerguel/flou/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
